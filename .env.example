# ==============================================================================
# EduAccess AI — Environment Configuration Example
# Copy this file to .env and configure with your specific values.
# NEVER commit your real .env file or GEMINI_API_KEY into version control.
# ==============================================================================

# Google Gemini API Configuration (Leave empty to enable honest local fallback mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=45.0
MOCK_AI_MODE=false

# Environment & Server
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS Allowed Origins (Comma-separated in production or JSON array)
# Note: In development, Vite runs on http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Resource & Upload Limits
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MiB (5 * 1024 * 1024)
MAX_PDF_PAGES=15
MAX_INPUT_TEXT_LENGTH=25000
URL_FETCH_TIMEOUT_SECONDS=10.0
URL_MAX_RESPONSE_BYTES=2097152 # 2 MiB

# Process-Local Rate Limiting (Single-instance deployment)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20
